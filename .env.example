NEWS_DB_PATH=data/news_monitor.db
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=20
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me
WECOM_MESSAGE_FORMAT=text
SEND_URGENT_ALERTS=true
URGENT_THRESHOLD=80
DIGEST_MIN_SCORE=36
DELIVERY_MAX_AGE_HOURS=5
TITLE_SIMILARITY_THRESHOLD=0.92
PIPELINE_SCHEDULE_TIMEZONE=Asia/Shanghai
PIPELINE_SCHEDULE_GRACE_MINUTES=30
MAX_DIGEST_ITEMS=8
YOUTUBE_VERIFY_TOKEN=replace-this-token
YOUTUBE_WEBHOOK_SECRET=
YOUTUBE_WEBHOOK_CALLBACK_URL=https://your-public-domain.example.com/youtube/webhook
